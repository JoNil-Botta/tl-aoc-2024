;; Run all 25 days in sequence and report total runtime.
(import stdlib.io)
(import stdlib.profile)
(import stdlib.string)
(import day01 as d1)
(import day02 as d2)
(import day03 as d3)
(import day04 as d4)
(import day05 as d5)
(import day06 as d6)
(import day07 as d7)
(import day08 as d8)
(import day09 as d9)
(import day10 as d10)
(import day11 as d11)
(import day12 as d12)
(import day13 as d13)
(import day14 as d14)
(import day15 as d15)
(import day16 as d16)
(import day17 as d17)
(import day18 as d18)
(import day19 as d19)
(import day20 as d20)
(import day21 as d21)
(import day22 as d22)
(import day23 as d23)
(import day24 as d24)
(import day25 as d25)

(define (main) : i64
  (let [t0 : i64 (profile.now-ms)]
    (begin
      (d1.solve-day01 "inputs/day01.txt")
      (d2.solve-day02 "inputs/day02.txt")
      (d3.solve-day03 "inputs/day03.txt")
      (d4.solve-day04 "inputs/day04.txt")
      (d5.solve-day05 "inputs/day05.txt")
      (d6.solve-day06 "inputs/day06.txt")
      (d7.solve-day07 "inputs/day07.txt")
      (d8.solve-day08 "inputs/day08.txt")
      (d9.solve-day09 "inputs/day09.txt")
      (d10.solve-day10 "inputs/day10.txt")
      (d11.solve-day11 "inputs/day11.txt")
      (d12.solve-day12 "inputs/day12.txt")
      (d13.solve-day13 "inputs/day13.txt")
      (d14.solve-day14 "inputs/day14.txt")
      (d15.solve-day15 "inputs/day15.txt")
      (d16.solve-day16 "inputs/day16.txt")
      (d17.solve-day17 "inputs/day17.txt")
      (d18.solve-day18 "inputs/day18.txt")
      (d19.solve-day19 "inputs/day19.txt")
      (d20.solve-day20 "inputs/day20.txt")
      (d21.solve-day21 "inputs/day21.txt")
      (d22.solve-day22 "inputs/day22.txt")
      (d23.solve-day23 "inputs/day23.txt")
      (d24.solve-day24 "inputs/day24.txt")
      (d25.solve-day25 "inputs/day25.txt")
      (let [t1 : i64 (profile.now-ms)]
        (begin
          (io.print-string "total: ")
          (io.print-string (string.int->string (- t1 t0)))
          (io.print-string " ms")
          (io.print-newline)
          0)))))
